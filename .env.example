# ─── SEO / analytics (all optional) ──────────────────────────
# Until these are set, no tracking scripts and no verification
# meta tags are emitted at all. See seo/SETUP.md.

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=

# Search Console HTML-tag verification (not needed if you verify via DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools (not needed if you import from GSC)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─── Turso (registration database) ───────────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── AI Studio (sketch → image) ──────────────────────────────
LIGHTX_API_KEY=

# ─── Outreach scripts (send_*.py) ────────────────────────────
# Zoho SMTP app password. Rotate via Zoho → My Account → App Passwords.
ZOHO_FROM_EMAIL=team@bananahacks.tech
ZOHO_APP_PASSWORD=
# Resend API key for send_followup.py / send_schools.py
RESEND_API_KEY=
